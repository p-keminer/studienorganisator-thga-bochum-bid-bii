# Optional backend overrides / Optionale Backend-Anpassungen
#
# Copy this file to backend/.env. The documented startup path works without it.
# Diese Datei nach backend/.env kopieren. Der dokumentierte Start funktioniert ohne sie.

# Async SQLite URL, relative to the backend working directory.
# Asynchrone SQLite-URL, relativ zum Backend-Arbeitsverzeichnis.
DATABASE_URL=sqlite+aiosqlite:///data/studienorganisator.db

# Enables OpenAPI pages and verbose SQLAlchemy output.
# Aktiviert OpenAPI-Seiten und ausführlichere SQLAlchemy-Ausgaben.
DEBUG_MODE=false

# Maximum upload size in MiB / Maximale Uploadgröße in MiB
MAX_UPLOAD_SIZE_MB=50

# Persistent source-file directory, relative to the backend working directory.
# Persistente Ablage der Quelldateien, relativ zum Backend-Arbeitsverzeichnis.
UPLOAD_DIR=uploads
